{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.13.7/.schema/devbox.schema.json",
  "packages": [
    "docker-compose@2.32.4",
    "yq-go@4.45.1",
    "dive@0.12.0",
    "git-cliff@2.8.0",
    "python313@latest",
    "yj@5.1.0",
    "uv@latest"
  ],
  "shell": {
    "init_hook": [
      "uv lock && uv sync",
      "source .venv/bin/activate"
    ],
    "scripts": {
      "bump": [
        "git pull",
        "git fetch --all --tags",
        "cz bump --changelog",
        "git push origin $(git tag --sort v:refname | cat | tail -n 1)",
        "git push origin"
      ],
      "bump_major": [
        "git pull",
        "git fetch --all --tags",
        "cz bump --changelog --increment MAJOR",
        "git push origin $(git tag --sort v:refname | cat | tail -n 1)",
        "git push origin"
      ]
    }
  }
}
